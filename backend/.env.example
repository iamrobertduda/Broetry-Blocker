# TypeSafe AI key for the Jev model. Without it the server falls back to a
# crude regex heuristic (fine for local development).
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Signs anonymous install tokens. Generate with: openssl rand -hex 32
TOKEN_SECRET=

# Rate limits (defaults shown)
# LIMIT_POSTS_PER_DAY_INSTALL=1000
# LIMIT_POSTS_PER_DAY_IP=4000
# LIMIT_BURST_CAPACITY=50
# LIMIT_BURST_REFILL_PER_MINUTE=30
# LIMIT_REGISTRATIONS_PER_DAY_IP=10
# LIMIT_GLOBAL_POSTS_PER_DAY=200000
